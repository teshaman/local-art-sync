<div class="las-toolbar">
  <button type="button" data-action="refresh" {{#if busy}}disabled{{/if}}>
    <i class="fa-solid fa-rotate {{#if busy}}fa-spin{{/if}}"></i> {{localize "LAS.Refresh"}}
  </button>
  <input type="text" data-filter value="{{filter}}" placeholder="{{localize 'LAS.FilterPlaceholder'}}">
  <span class="las-meta"><i class="fa-solid fa-folder"></i> {{path}} · {{count}} {{localize "LAS.Files"}} · {{host}}</span>
</div>

{{#if error}}<p class="las-error">{{error}}</p>{{/if}}

{{#if files.length}}
<div class="las-grid">
  {{#each files}}
  <div class="las-card" draggable="true" data-name="{{name}}" data-url="{{url}}">
    {{#if (eq kind "image")}}
    <img src="{{url}}" alt="{{name}}" loading="lazy">
    {{else}}
    <div class="las-placeholder"><i class="fa-solid {{#if (eq kind "audio")}}fa-music{{else if (eq kind "video")}}fa-film{{else}}fa-file{{/if}}"></i></div>
    {{/if}}
    <div class="las-name" title="{{name}}">{{name}}</div>
    <div class="las-actions">
      <button type="button" data-action="copy" data-tooltip="{{localize 'LAS.Tip.Copy'}}"><i class="fa-solid fa-copy"></i></button>
      <button type="button" data-action="open" data-tooltip="{{localize 'LAS.Tip.Open'}}"><i class="fa-solid fa-up-right-from-square"></i></button>
      {{#if (eq kind "image")}}
      <button type="button" data-action="applyToken" data-tooltip="{{localize 'LAS.Tip.ApplyToken'}}"><i class="fa-solid fa-user-astronaut"></i></button>
      {{/if}}
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<p class="las-empty">{{#if busy}}{{localize "LAS.Loading"}}{{else}}{{localize "LAS.Empty"}}{{/if}}</p>
{{/if}}

<footer class="las-footer">{{localize "LAS.Footer"}}</footer>
